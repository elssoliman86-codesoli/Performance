<Application x:Class="Performance.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#070B16"/>
        <SolidColorBrush x:Key="Panel" Color="#101A2B"/>
        <SolidColorBrush x:Key="Panel2" Color="#0D1525"/>
        <SolidColorBrush x:Key="Accent" Color="#398BFF"/>
        <SolidColorBrush x:Key="Cyan" Color="#42C8FF"/>
        <SolidColorBrush x:Key="TextMain" Color="#F2F6FF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8C9BB5"/>
    </Application.Resources>
</Application>