<Window x:Class="Performance.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PERFORMANCE" Width="1260" Height="820" MinWidth="1020" MinHeight="680"
        WindowStyle="None" ResizeMode="CanResize" Background="#070B16"
        Foreground="#F2F6FF" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" CornerRadius="18" GlassFrameThickness="0"
                            ResizeBorderThickness="7" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#A8B7D0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#17243A"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#203A5C"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F2F6FF"/>
            <Setter Property="Background" Value="#1D5FC8"/>
            <Setter Property="BorderBrush" Value="#398BFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="4,3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#287CEB"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.75"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.35"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#17243A"/>
            <Setter Property="BorderBrush" Value="#2B3D58"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#0D1525"/>
            <Setter Property="Foreground" Value="#E6EEFC"/>
            <Setter Property="BorderBrush" Value="#22324B"/>
            <Setter Property="RowBackground" Value="#0D1525"/>
            <Setter Property="AlternatingRowBackground" Value="#111D30"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#1D2A40"/>
            <Setter Property="VerticalGridLinesBrush" Value="#0D1525"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="ColumnHeaderHeight" Value="42"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#17243A"/>
            <Setter Property="Foreground" Value="#91A6C4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="#111C2E"/>
            <Setter Property="BorderBrush" Value="#243651"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="17"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#F2F6FF"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8C9BB5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Border Background="#070B16" BorderBrush="#253751" BorderThickness="1" CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#0B1322" CornerRadius="18,18,0,0" BorderBrush="#172943" BorderThickness="0,0,0,1">
                <Grid Margin="20,0,14,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="29" Height="29" CornerRadius="9" Background="#173D72" Margin="0,0,11,0">
                            <TextBlock Text="P" Foreground="#6ED7FF" FontWeight="Black" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="PERFORMANCE" FontSize="13" FontWeight="Black"  Foreground="#F2F6FF"/>
                            <TextBlock Text="GAMERLOOP  /  SYSTEM INTELLIGENCE" FontSize="9" Foreground="#7185A4" />
                        </StackPanel>
                        <Border Background="#102B37" CornerRadius="7" Padding="9,4" Margin="14,0,0,0">
                            <TextBlock Text="LIVE MONITOR" FontSize="9" FontWeight="Bold" Foreground="#54D9C7"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock x:Name="HeaderClock" Foreground="#8C9BB5" FontSize="12" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <Button Content="—" Width="34" Height="30" Click="Minimize_Click" Background="Transparent" BorderThickness="0" Foreground="#9DB0CB" FontSize="17"/>
                        <Button Content="×" Width="34" Height="30" Click="Hide_Click" Background="Transparent" BorderThickness="0" Foreground="#FF7586" FontSize="20"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="214"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#0B1322" BorderBrush="#172943" BorderThickness="0,0,1,0" CornerRadius="0,0,0,18">
                    <DockPanel Margin="14,18,14,16">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="Bold" Foreground="#607693" Margin="12,4,0,12" />
                            <Button x:Name="NavDashboard" Style="{StaticResource NavButton}" Content="◈   Dashboard" Click="NavDashboard_Click" Foreground="#FFFFFF" Background="#16345A"/>
                            <Button Style="{StaticResource NavButton}" Content="▤   Processes" Click="NavProcesses_Click"/>
                            <Button Style="{StaticResource NavButton}" Content="⇄   Network" Click="NavNetwork_Click"/>
                            <Button Style="{StaticResource NavButton}" Content="▦   Installed apps" Click="NavApps_Click"/>
                            <Button Style="{StaticResource NavButton}" Content="▧   Storage analyzer" Click="NavStorage_Click"/>
                            <Button Style="{StaticResource NavButton}" Content="⬡   Threatening" Click="NavThreat_Click"/>
                            <Button Style="{StaticResource NavButton}" Content="✧   AI Settings" Click="NavAi_Click"/>

                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom">
                            <Border Background="#101D30" BorderBrush="#223651" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="SESSION STATUS" Foreground="#7085A3" FontSize="9" FontWeight="Bold" />
                                    <TextBlock x:Name="SessionStateText" Text="DESKTOP MODE" Foreground="#52D7C4" FontSize="12" FontWeight="Bold" Margin="0,7,0,2"/>
                                    <TextBlock Text="Overlay stays passive while gaming." TextWrapping="Wrap" Foreground="#8395B0" FontSize="10"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="PERFORMANCE  •  v0.1.0" Foreground="#526780" FontSize="9" Margin="10,0,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TabControl x:Name="MainTabs" Grid.Column="1" Background="#070B16" BorderThickness="0" SelectedIndex="0">
                    <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style></TabControl.Resources>
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="26,22,26,26">
                                <Grid Margin="0,0,0,17">
                                    <StackPanel>
                                        <TextBlock Text="System overview" FontSize="25" FontWeight="Bold" Foreground="#F2F6FF"/>
                                        <TextBlock Text="Live telemetry, gaming session and resource pressure." FontSize="12" Foreground="#8193AD" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#10243A" BorderBrush="#254A70" BorderThickness="1" CornerRadius="10" Padding="12,7">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="#48D8B5" Margin="0,0,8,0"/>
                                            <TextBlock Text="SENSORS ONLINE" Foreground="#91DCCE" FontSize="10" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <UniformGrid Columns="4" Rows="1">
                                    <Border Style="{StaticResource MetricCard}">
                                        <StackPanel>
                                            <TextBlock Text="CPU LOAD" Foreground="#8C9BB5" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock x:Name="CpuValue" Text="--%" FontSize="31" FontWeight="Bold" Margin="0,8,0,0"/>
                                            <TextBlock x:Name="CpuTempValue" Text="Temp  — °C" Foreground="#55CFFF" FontSize="11" Margin="0,2,0,10"/>
                                            <ProgressBar x:Name="CpuBar" Height="5" Maximum="100" Value="0" Foreground="#398BFF" Background="#24334B"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource MetricCard}">
                                        <StackPanel>
                                            <TextBlock Text="GPU LOAD" Foreground="#8C9BB5" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock x:Name="GpuValue" Text="--%" FontSize="31" FontWeight="Bold" Margin="0,8,0,0"/>
                                            <TextBlock x:Name="GpuTempValue" Text="Temp  — °C" Foreground="#55CFFF" FontSize="11" Margin="0,2,0,10"/>
                                            <ProgressBar x:Name="GpuBar" Height="5" Maximum="100" Value="0" Foreground="#42C8FF" Background="#24334B"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource MetricCard}">
                                        <StackPanel>
                                            <TextBlock Text="SYSTEM MEMORY" Foreground="#8C9BB5" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock x:Name="RamValue" Text="--%" FontSize="31" FontWeight="Bold" Margin="0,8,0,0"/>
                                            <TextBlock x:Name="RamDetail" Text="— / — GB" Foreground="#55CFFF" FontSize="11" Margin="0,2,0,10"/>
                                            <ProgressBar x:Name="RamBar" Height="5" Maximum="100" Value="0" Foreground="#9B86FF" Background="#24334B"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource MetricCard}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="SYSTEM DRIVE" Foreground="#8C9BB5" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock x:Name="DriveValue" Text="--%" FontSize="31" FontWeight="Bold" Margin="0,8,0,0"/>
                                            <TextBlock x:Name="DriveDetail" Text="— / — GB" Foreground="#55CFFF" FontSize="11" Margin="0,2,0,10"/>
                                            <ProgressBar x:Name="DriveBar" Height="5" Maximum="100" Value="0" Foreground="#F2A65A" Background="#24334B"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Grid Margin="0,2,0,13">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#101A2B" BorderBrush="#233651" BorderThickness="1" CornerRadius="17" Padding="18" Margin="0,0,12,0">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="Process pulse" Style="{StaticResource SectionTitle}"/>
                                                    <TextBlock Text="Top memory consumers • refreshes automatically" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <Button Content="VIEW ALL  →" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource QuietButton}" Click="NavProcesses_Click" Padding="10,7" FontSize="10"/>
                                            </Grid>
                                            <DataGrid x:Name="DashboardProcessGrid" Height="250" Margin="0,15,0,0" IsReadOnly="True" CanUserSortColumns="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="PROCESS" Binding="{Binding Name}" Width="*"/>
                                                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="60"/>
                                                    <DataGridTextColumn Header="RAM MB" Binding="{Binding MemoryMb, StringFormat=N0}" Width="85"/>
                                                    <DataGridTextColumn Header="CPU %" Binding="{Binding CpuPercent, StringFormat=N1}" Width="72"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="#101A2B" BorderBrush="#233651" BorderThickness="1" CornerRadius="17" Padding="18">
                                        <StackPanel>
                                            <TextBlock Text="Gaming session" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock x:Name="GameNameText" Text="No game detected" Foreground="#8C9BB5" FontSize="12" Margin="0,6,0,0"/>
                                            <Border Background="#0B1423" CornerRadius="14" Padding="14" Margin="0,17,0,12">
                                                <StackPanel>
                                                    <TextBlock Text="TIME IN CURRENT SESSION" Foreground="#7388A6" FontSize="9" FontWeight="Bold"/>
                                                    <TextBlock x:Name="GameDurationText" Text="00:00:00" Foreground="#FFFFFF" FontSize="31" FontWeight="Bold" Margin="0,7,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Grid Margin="0,2,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="FRAME RATE" Foreground="#8296B2" FontSize="10"/>
                                                    <TextBlock x:Name="FpsText" Text="— FPS" FontSize="24" Foreground="#52D7C4" FontWeight="Bold" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <StackPanel HorizontalAlignment="Right">
                                                    <TextBlock Text="GRAPHICS DEVICE" Foreground="#8296B2" FontSize="10" HorizontalAlignment="Right"/>
                                                    <TextBlock x:Name="GpuNameText" Text="Detecting GPU…" Foreground="#D5E1F2" FontSize="10" TextWrapping="Wrap" TextAlignment="Right" Width="145" Margin="0,5,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="FPS requires PresentMon capture. Administrator mode may be needed; some anti-cheat protected games block telemetry." TextWrapping="Wrap" Foreground="#7185A1" FontSize="10" Margin="0,17,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="StatusText" Text="Initializing hardware sensors…" Foreground="#7185A1" FontSize="10" Margin="2,2,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem>
                        <Grid Margin="26,22,26,26">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Process manager" FontSize="25" FontWeight="Bold"/>
                                <TextBlock Text="Applications and background processes • RAM, CPU, PID and executable path." Foreground="#8193AD" FontSize="12" Margin="0,5,0,15"/>
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <TextBox x:Name="ProcessSearchBox" Width="300" Height="36" HorizontalAlignment="Left" VerticalContentAlignment="Center" Padding="10,0" Background="#111C2E" Foreground="#F2F6FF" BorderBrush="#2B3D58" TextChanged="ProcessSearch_TextChanged"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="REFRESH" Style="{StaticResource QuietButton}" Click="RefreshProcesses_Click"/>
                                    <Button Content="END TASK" Style="{StaticResource ActionButton}" Background="#9D3046" BorderBrush="#C24A61" Click="EndTask_Click"/>
                                </StackPanel>
                            </Grid>
                            <DataGrid x:Name="ProcessGrid" Grid.Row="2" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PROCESS" Binding="{Binding Name}" Width="180"/>
                                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70"/>
                                    <DataGridTextColumn Header="MEMORY (MB)" Binding="{Binding MemoryMb, StringFormat=N1}" Width="105"/>
                                    <DataGridTextColumn Header="CPU %" Binding="{Binding CpuPercent, StringFormat=N1}" Width="80"/>
                                    <DataGridTextColumn Header="SESSION" Binding="{Binding Session}" Width="90"/>
                                    <DataGridTextColumn Header="EXECUTABLE PATH" Binding="{Binding Path}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem>
                        <Grid Margin="26,22,26,26">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Network connections" FontSize="25" FontWeight="Bold"/>
                                <TextBlock Text="TCP local endpoint → remote destination, owning process and connection state." Foreground="#8193AD" FontSize="12" Margin="0,5,0,15"/>
                            </StackPanel>
                            <DataGrid x:Name="NetworkGrid" Grid.Row="1" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PROCESS" Binding="{Binding ProcessName}" Width="150"/>
                                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="65"/>
                                    <DataGridTextColumn Header="LOCAL IP" Binding="{Binding LocalAddress}" Width="*"/>
                                    <DataGridTextColumn Header="LOCAL PORT" Binding="{Binding LocalPort}" Width="90"/>
                                    <DataGridTextColumn Header="REMOTE IP" Binding="{Binding RemoteAddress}" Width="*"/>
                                    <DataGridTextColumn Header="REMOTE PORT" Binding="{Binding RemotePort}" Width="95"/>
                                    <DataGridTextColumn Header="STATE" Binding="{Binding State}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem>
                        <Grid Margin="26,22,26,26">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="150"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Installed applications" FontSize="25" FontWeight="Bold"/>
                                <TextBlock Text="Programs registered by Windows • review before uninstalling or cleaning leftovers." Foreground="#8193AD" FontSize="12" Margin="0,5,0,14"/>
                            </StackPanel>
                            <DataGrid x:Name="AppsGrid" Grid.Row="1" IsReadOnly="True" SelectionChanged="AppsGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="APPLICATION" Binding="{Binding DisplayName}" Width="*"/>
                                    <DataGridTextColumn Header="PUBLISHER" Binding="{Binding Publisher}" Width="180"/>
                                    <DataGridTextColumn Header="VERSION" Binding="{Binding Version}" Width="100"/>
                                    <DataGridTextColumn Header="EST. SIZE (MB)" Binding="{Binding EstimatedSizeMb, StringFormat=N0}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Grid.Row="2" Background="#101A2B" BorderBrush="#233651" BorderThickness="1" CornerRadius="15" Padding="13" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="SelectedAppText" Text="Select an application to inspect it." FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="Residual folders are only suggested locations. Review each path before deleting; shared dependencies are not auto-cleaned." Foreground="#8296B2" FontSize="10" TextWrapping="Wrap" Margin="0,6,12,0"/>
                                        <TextBlock x:Name="ResidualText" Text="" Foreground="#57D7C8" FontSize="10" TextWrapping="Wrap" Margin="0,4,12,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="FIND LEFTOVERS" Style="{StaticResource QuietButton}" Click="FindResiduals_Click"/>
                                        <Button Content="UNINSTALL" Style="{StaticResource ActionButton}" Background="#9D3046" BorderBrush="#C24A61" Click="UninstallApp_Click"/>
                                        <Button Content="DELETE SELECTED FOLDER" Style="{StaticResource QuietButton}" Background="#563044" BorderBrush="#8D4961" Click="DeleteResidual_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem>
                        <Grid Margin="26,22,26,26">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Storage intelligence" FontSize="25" FontWeight="Bold"/>
                                <TextBlock Text="Find large files and understand where storage is being used." Foreground="#8193AD" FontSize="12" Margin="0,5,0,15"/>
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="0,0,0,12">
                                <TextBox x:Name="StorageRootBox" Height="36" VerticalContentAlignment="Center" Padding="10,0" Background="#111C2E" Foreground="#F2F6FF" BorderBrush="#2B3D58" Text=""/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="CHOOSE FOLDER" Style="{StaticResource QuietButton}" Click="ChooseStorageRoot_Click"/>
                                    <Button Content="SCAN" Style="{StaticResource ActionButton}" Click="ScanStorage_Click"/>
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="2" Margin="0,0,0,12">
                                <TextBlock x:Name="StorageSummaryText" Text="Choose a drive or folder, then start a scan." Foreground="#8C9BB5" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StorageCategoryText" Text="" Foreground="#55CFFF" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <DataGrid x:Name="StorageGrid" Grid.Row="3" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="FILE" Binding="{Binding Name}" Width="190"/>
                                    <DataGridTextColumn Header="TYPE" Binding="{Binding Category}" Width="130"/>
                                    <DataGridTextColumn Header="SIZE (MB)" Binding="{Binding SizeMb, StringFormat=N1}" Width="105"/>
                                    <DataGridTextColumn Header="LAST MODIFIED" Binding="{Binding Modified, StringFormat=g}" Width="150"/>
                                    <DataGridTextColumn Header="LOCATION" Binding="{Binding FullPath}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem>
                        <Grid Margin="26,22,26,26">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="150"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                                <TextBlock Text="Threatening · Live process intelligence" FontSize="25" FontWeight="Bold"/>
                                <TextBlock Text="Explainable defensive triage. Scores are signals for review, not proof of malware. No process is stopped automatically." Foreground="#8193AD" FontSize="12" Margin="0,5,0,0"/>
                                <DockPanel Margin="0,12,0,0">
                                    <TextBox x:Name="ThreatReportPathText" Text="Reports: LocalAppData\Performance\Reports" Width="470" Height="32" Padding="8" VerticalContentAlignment="Center" Background="#111C2E" Foreground="#F2F6FF" BorderBrush="#2B3D58"/>
                                    <Button Content="CHOOSE FOLDER" Style="{StaticResource QuietButton}" Click="ChooseThreatReportFolder_Click" DockPanel.Dock="Right"/>
                                    <Button Content="AI EXPLAIN SELECTED" Style="{StaticResource QuietButton}" Click="AnalyzeThreat_Click" DockPanel.Dock="Right"/>
                                    <Button Content="REFRESH ANALYSIS" Style="{StaticResource ActionButton}" Click="RefreshThreat_Click" DockPanel.Dock="Right"/>
                                </DockPanel>
                            </StackPanel>
                            <DataGrid x:Name="ThreatGrid" Grid.Row="1" IsReadOnly="True" SelectionChanged="ThreatGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="RISK" Binding="{Binding Risk}" Width="90"/>
                                    <DataGridTextColumn Header="SCORE" Binding="{Binding RiskScore}" Width="65"/>
                                    <DataGridTextColumn Header="PROCESS" Binding="{Binding ProcessName}" Width="150"/>
                                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="65"/>
                                    <DataGridTextColumn Header="RAM MB" Binding="{Binding MemoryMb, StringFormat=N0}" Width="85"/>
                                    <DataGridTextColumn Header="PUBLISHER" Binding="{Binding Publisher}" Width="150"/>
                                    <DataGridTextColumn Header="SIGNATURE" Binding="{Binding SignatureStatus}" Width="160"/>
                                    <DataGridTextColumn Header="EXECUTABLE" Binding="{Binding ExecutablePath}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Grid.Row="2" Background="#101A2B" BorderBrush="#243651" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,12,0,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="ThreatDetailsText" Text="Select a process to inspect its evidence, SHA-256, observed endpoints and heuristic reasons." TextWrapping="Wrap" Foreground="#B9C9DE" FontSize="11"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="26,22,26,26">
                                <TextBlock Text="NVIDIA AI Provider" FontSize="25" FontWeight="Bold"/>
                                <TextBlock Text="OpenAI-compatible NVIDIA API configuration. API keys are protected with Windows DPAPI for the current user." Foreground="#8193AD" FontSize="12" Margin="0,5,0,18"/>
                                <TextBlock Text="BASE URL" Foreground="#8C9BB5" FontSize="10" FontWeight="Bold"/>
                                <TextBox x:Name="AiBaseUrlBox" Text="https://integrate.api.nvidia.com/v1" Height="38" Padding="10" Margin="0,6,0,12" Background="#111C2E" Foreground="#F2F6FF" BorderBrush="#2B3D58"/>
                                <TextBlock Text="NVIDIA API KEY" Foreground="#8C9BB5" FontSize="10" FontWeight="Bold"/>
                                <PasswordBox x:Name="AiApiKeyBox" Height="38" Padding="10" Margin="0,6,0,12" Background="#111C2E" Foreground="#F2F6FF" BorderBrush="#2B3D58"/>
                                <TextBlock Text="MODEL" Foreground="#8C9BB5" FontSize="10" FontWeight="Bold"/>
                                <ComboBox x:Name="AiModelBox" Height="38" Margin="0,6,0,12" IsEditable="True" Background="#111C2E" Foreground="#F2F6FF"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="LIST MODELS" Style="{StaticResource QuietButton}" Click="ListAiModels_Click"/>
                                    <Button Content="SAVE PROVIDER" Style="{StaticResource ActionButton}" Click="SaveAiProvider_Click"/>
                                    <Button Content="TEST AI" Style="{StaticResource QuietButton}" Click="TestAiProvider_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="AiStatusText" Text="Not configured. The AI is advisory only and cannot execute actions." Foreground="#8C9BB5" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                <Border Background="#101A2B" BorderBrush="#243651" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,22,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Privacy and control" FontSize="16" FontWeight="Bold"/>
                                        <TextBlock Text="Only telemetry you explicitly send for analysis is sent to the selected API. API keys are stored encrypted for this Windows account. Reports remain on the folder configured for local monitoring. No auto-remediation, process termination, deletion, driver installation or Windows Update installation is permitted." Foreground="#9AACC5" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Border>
</Window>
