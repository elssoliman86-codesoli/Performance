<Window x:Class="Performance.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="545" Height="62" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" WindowStartupLocation="Manual"
        MouseLeftButtonUp="Overlay_Click">
    <Border Background="#F20A1424" BorderBrush="#5A3B78A6" BorderThickness="1"
            CornerRadius="31" Padding="12,7">
        <Border.Effect><DropShadowEffect Color="#001020" BlurRadius="22" ShadowDepth="5" Opacity="0.62"/></Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="34" Height="34" Background="#173D72" CornerRadius="17" VerticalAlignment="Center" Margin="2,0,11,0">
                <TextBlock Text="P" FontSize="19" FontWeight="Black" Foreground="#6ED7FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="GameLabel" Text="PERFORMANCE  •  GAMING MODE" Foreground="#EAF2FF" FontSize="10" FontWeight="Bold" />
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock x:Name="FpsLabel" Text="— FPS" Foreground="#55DCC7" FontWeight="Bold" FontSize="12" Margin="0,0,14,0"/>
                    <TextBlock x:Name="GpuLabel" Text="GPU —°" Foreground="#68CFFF" FontSize="11" Margin="0,0,13,0"/>
                    <TextBlock x:Name="CpuLabel" Text="CPU —°" Foreground="#A9BCE0" FontSize="11" Margin="0,0,13,0"/>
                    <TextBlock x:Name="DurationLabel" Text="00:00:00" Foreground="#D5E1F2" FontSize="11"/>
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="ClockLabel" Grid.Column="2" Text="00:00" Foreground="#8FA4C2" FontSize="11" VerticalAlignment="Center" Margin="12,0,5,0"/>
        </Grid>
    </Border>
</Window>
